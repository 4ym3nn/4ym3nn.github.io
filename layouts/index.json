{{- $posts := slice -}}
{{- range where (where .Site.RegularPages "Type" "in" .Site.Params.front_page_content) "Title" "ne" "" -}}
  {{- $posts = $posts | append (dict "title" .Title "url" .RelPermalink "section" .Section "summary" (partial "article-excerpt.html" .) "content" .Plain "tags" (.Params.tags | default slice) "date" (.Date.Format "Jan 2, 2006") "readingTime" .ReadingTime) -}}
{{- end -}}
{{- $posts | jsonify -}}
