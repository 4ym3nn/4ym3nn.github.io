{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML -}}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
<channel>
  <title>{{ if not .IsHome }}{{ .Title }} · {{ end }}{{ .Site.Title }}</title>
  <link>{{ .Permalink }}</link>
  <description>{{ .Description | default .Site.Params.description }}</description>
  <language>{{ .Site.LanguageCode }}</language>
  {{ with .OutputFormats.Get "RSS" }}<atom:link href="{{ .Permalink }}" rel="self" type="application/rss+xml"/>{{ end }}
  {{ $pages := .RegularPagesRecursive }}
  {{ if .IsHome }}{{ $pages = where .Site.RegularPages "Type" "in" .Site.Params.front_page_content }}{{ end }}
  {{ range first 30 (where $pages "Title" "ne" "").ByDate.Reverse }}
  <item>
    <title>{{ .Title }}</title>
    <link>{{ .Permalink }}</link>
    <guid>{{ .Permalink }}</guid>
    <pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" }}</pubDate>
    <description>{{ partial "article-excerpt.html" . }}</description>
  </item>
  {{ end }}
</channel>
</rss>
